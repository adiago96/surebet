# === The Odds API (https://the-odds-api.com) ===
# Regístrate gratis en https://the-odds-api.com (sin tarjeta -> no pueden
# cobrarte nada por accidente). Free tier real comprobado en sept-2026:
# 500 créditos/mes. Coste por PASADA COMPLETA del scanner =
#   (nº de deportes en SPORTS) x (nº de mercados en MARKETS) x (nº de regiones)
# porque el collector hace una llamada por deporte, y cada llamada cuesta
# markets x regions. Con los valores de abajo (2 deportes x 3 mercados x 1
# región = 6 créditos/pasada) y POLL_INTERVAL_SECONDS=43200 (cada 12h, 2
# veces al día) el gasto es 6 x 2 x 30 = 360 créditos/mes: por debajo de 500,
# con margen para pasadas manuales (--once) de prueba.
#
# Fórmula para cambiar esto sin pasarte de presupuesto:
#   creditos_por_pasada = nº_deportes x nº_mercados x nº_regiones
#   pasadas_por_mes_seguras = 450 / creditos_por_pasada   (450 = margen, no 500)
#   POLL_INTERVAL_SECONDS = 30 x 86400 / pasadas_por_mes_seguras
# El collector además se detiene solo si el crédito restante que reporta la
# API baja de THE_ODDS_API_MIN_CREDITS_RESERVE, como red de seguridad.
THE_ODDS_API_KEY=
THE_ODDS_API_MIN_CREDITS_RESERVE=5

# Regiones de bookmakers a consultar (eu = Pinnacle, Marathonbet, Betfair
# Exchange EU, Unibet FR/IT/NL/SE, Winamax DE/FR, William Hill, 888sport...).
# NO existe región "es": no hay bookmakers españoles (Codere/Luckia/Sportium/
# Bwin) disponibles vía esta API a fecha de esta investigación.
THE_ODDS_API_REGIONS=eu

# === Pinnacle guest API (pública, sin key, sin coste, sin límite documentado) ===
PINNACLE_ENABLED=true

# === Deportes a vigilar (claves estilo The Odds API, separadas por comas) ===
# Solo 2 por defecto para caber en el presupuesto gratuito con una cadencia
# razonable (ver cuentas arriba). Añade más solo si también subes
# POLL_INTERVAL_SECONDS proporcionalmente.
SPORTS=soccer_spain_la_liga,soccer_uefa_champs_league
MARKETS=h2h,spreads,totals

# === Bankroll y stakes ===
BANKROLL_EUR=100
DEFAULT_MIN_STAKE_INCREMENT=1.0
DEFAULT_MAX_STAKE_PER_BOOKMAKER=500

# === Umbrales de arbitraje / riesgo ===
MIN_PROFIT_PCT_TO_ALERT=0.5
SUSPICIOUS_PROFIT_PCT=12.0
PREMATCH_FRESH_SECONDS=180
PREMATCH_STALE_SECONDS=900
LIVE_FRESH_SECONDS=5
LIVE_STALE_SECONDS=20

# === Bucle del scanner ===
# 43200s = 12h (2 pasadas/día). Ver la fórmula de créditos más arriba antes
# de bajar este valor: bajarlo sin reducir SPORTS/MARKETS agota el free tier
# de The Odds API antes de fin de mes.
POLL_INTERVAL_SECONDS=43200

# === Telegram ===
# 1. Habla con @BotFather en Telegram -> /newbot -> copia el token aquí.
# 2. Escribe un mensaje a tu bot y visita:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    para obtener tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Almacenamiento ===
SQLITE_PATH=data/surebet.db

# === Dashboard ===
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
